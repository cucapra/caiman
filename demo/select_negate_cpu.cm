#version 0.1.0

sptl space(s: BufferSpace) -> BufferSpace { returns s }
tmln time(e: Event) -> Event { returns e }

extern(cpu) pure sum([i32; 4]) -> i32
extern(cpu) pure negate([i32; 4]) -> [i32; 4]

val select_negate(v1: [i32; 4], v2: [i32; 4], v3: [i32; 4]) -> out: [i32; 4] {
    sum1 :- sum(v1)
    neg2 :- negate(v2)
    neg3 :- negate(v3)
    condition :- sum1 < 0
    result :- neg2 if condition else neg3
    returns result
}

fn select_negate_impl(
    v1: [i32; 4], 
    v2: [i32; 4], 
    v3: [i32; 4]
) 
-> [i32; 4] impls select_negate,time,space {
    let y = negate(v3);
    let x = negate(v2);
    if sum(v1) < 0 {
        x
    }
    else {
        y
    }
}

pipeline main { select_negate_impl }